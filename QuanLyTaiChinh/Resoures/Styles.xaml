<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Màu nền & chữ chung -->
    <SolidColorBrush x:Key="PageBg"        Color="#F3F6FB"/>
    <SolidColorBrush x:Key="ColorPrimary"  Color="#3B82F6"/>
    <SolidColorBrush x:Key="TextDark"      Color="#111827"/>
    <SolidColorBrush x:Key="TextGray"      Color="#6B7280"/>
    <SolidColorBrush x:Key="TextGreen"     Color="#059669"/>
    <SolidColorBrush x:Key="TextRed"       Color="#DC2626"/>

    <!-- Nền 4 thẻ số liệu -->
    <SolidColorBrush x:Key="CardBlueBg"    Color="#DBEAFE"/>
    <SolidColorBrush x:Key="CardGreenBg"   Color="#D1FAE5"/>
    <SolidColorBrush x:Key="CardRedBg"     Color="#FEE2E2"/>
    <SolidColorBrush x:Key="CardPurpleBg"  Color="#EDE9FE"/>

    <!-- Nền menu đang chọn ở sidebar -->
    <SolidColorBrush x:Key="NavActiveBg"   Color="#DCEBFC"/>

    <!-- Khung thẻ bo góc trắng dùng chung cho mọi Card -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Background" Value="White"/>
    </Style>

    <!-- 4 biến thể màu của thẻ số liệu, kế thừa CardStyle -->
    <Style x:Key="StatCardBlue" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Background" Value="{StaticResource CardBlueBg}"/>
    </Style>
    <Style x:Key="StatCardGreen" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Background" Value="{StaticResource CardGreenBg}"/>
    </Style>
    <Style x:Key="StatCardRed" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Background" Value="{StaticResource CardRedBg}"/>
    </Style>
    <Style x:Key="StatCardPurple" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Background" Value="{StaticResource CardPurpleBg}"/>
    </Style>

    <!-- Chữ: nhãn nhỏ phía trên (VD "SỐ DƯ HIỆN TẠI") -->
    <Style x:Key="StatLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextGray}"/>
    </Style>

    <!-- Chữ: số liệu to (VD "16.400.000đ") -->
    <Style x:Key="StatValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
        <Setter Property="Margin" Value="0,8,0,8"/>
    </Style>

    <!-- Chữ tiêu đề trang (VD "Tổng quan") -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
    </Style>

    <!-- Nút xanh bo tròn (VD "+ Thêm giao dịch") -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ColorPrimary}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="20"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    

</ResourceDictionary>