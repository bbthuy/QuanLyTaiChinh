<Window x:Class="QuanLyTaiChinh.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:QuanLyTaiChinh.ViewModels"
        xmlns:views="clr-namespace:QuanLyTaiChinh.View"
        Title="FinanceWise" Height="850" Width="1440"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBg}">

    <!-- DataTemplate: ViewModel nao thi hien View tuong ung -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TransactionsViewModel}">
            <views:TransactionsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BudgetsViewModel}">
            <views:BudgetsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AnalyticsViewModel}">
            <views:AnalyticsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SavingGoalsViewModel}">
            <views:SavingGoalsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== SIDEBAR ===== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBg}">
            <StackPanel Margin="20">

                <!-- Logo -->
                <StackPanel Orientation="Horizontal" Margin="4,10,0,30">
                    <Border Background="{StaticResource ColorPrimary}" CornerRadius="10" Width="40" Height="40">
                        <TextBlock Text="$" Foreground="White" FontWeight="Bold" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="FinanceWise" FontWeight="Bold" FontSize="16"
                                   Foreground="{StaticResource TextDark}"/>
                        <TextBlock Text="Quản lý tài chính" Style="{StaticResource PageSubtitleStyle}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="MENU" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource TextGray}" Margin="14,0,0,10"/>

                <RadioButton Style="{StaticResource SidebarNavItem}"
                             Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                             IsChecked="{Binding SelectedMenu, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Dashboard, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📊" Margin="0,0,10,0"/>
                        <TextBlock Text="Tổng quan" Style="{StaticResource SidebarNavText}"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton Style="{StaticResource SidebarNavItem}"
                             Command="{Binding NavigateCommand}" CommandParameter="Transactions"
                             IsChecked="{Binding SelectedMenu, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Transactions, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="↕️" Margin="0,0,10,0"/>
                        <TextBlock Text="Giao dịch" Style="{StaticResource SidebarNavText}"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton Style="{StaticResource SidebarNavItem}"
                             Command="{Binding NavigateCommand}" CommandParameter="Budgets"
                             IsChecked="{Binding SelectedMenu, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Budgets, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🕐" Margin="0,0,10,0"/>
                        <TextBlock Text="Ngân sách" Style="{StaticResource SidebarNavText}"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton Style="{StaticResource SidebarNavItem}"
                             Command="{Binding NavigateCommand}" CommandParameter="Analytics"
                             IsChecked="{Binding SelectedMenu, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Analytics, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📈" Margin="0,0,10,0"/>
                        <TextBlock Text="Phân tích" Style="{StaticResource SidebarNavText}"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton Style="{StaticResource SidebarNavItem}"
                             Command="{Binding NavigateCommand}" CommandParameter="SavingGoals"
                             IsChecked="{Binding SelectedMenu, Converter={StaticResource StringEqualsConverter}, ConverterParameter=SavingGoals, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🎯" Margin="0,0,10,0"/>
                        <TextBlock Text="Mục tiêu" Style="{StaticResource SidebarNavText}"/>
                    </StackPanel>
                </RadioButton>

            </StackPanel>
        </Border>

        <!-- ===== VÙNG NỘI DUNG: đổi theo CurrentViewModel ===== -->

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ContentControl x:Name="MainContent" Grid.Column="1" Grid.Row="1" Content="{Binding CurrentViewModel}" Margin="10"/>
            <Border Background="White" BorderBrush="{StaticResource PageBg}" Height="50"  CornerRadius="5" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="False">

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Margin="0,0,14,0">
                            <ToggleButton x:Name="BtnNotification" 
                                  Style="{StaticResource IconToggleButton}">
                                <TextBlock Text="🔔" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </ToggleButton>
                            <Popup IsOpen="{Binding IsChecked, ElementName=BtnNotification}" 
                           StaysOpen="False" 
                           Placement="Bottom" 
                           PlacementTarget="{Binding ElementName=BtnNotification}"
                           AllowsTransparency="True" 
                           PopupAnimation="Fade">
                                <Border Style="{StaticResource PopupCardStyle}" Width="280" Margin="0,8,0,0">
                                    <ListView>
                                        
                                    </ListView>
                                </Border>
                            </Popup>
                        </Grid>

                        <Grid>
                            <ToggleButton x:Name="BtnProfile" 
                                  Style="{StaticResource AvatarToggleButton}">
                                <TextBlock Text="T" FontWeight="Bold" Foreground="White" FontSize="16"/>
                            </ToggleButton>

                            <!-- Dropdown danh mục tài khoản -->
                            <Popup IsOpen="{Binding IsChecked, ElementName=BtnProfile}" 
                           StaysOpen="False" 
                           Placement="Bottom" 
                           PlacementTarget="{Binding ElementName=BtnProfile}"
                           AllowsTransparency="True" 
                           PopupAnimation="Fade">
                                <Border Style="{StaticResource PopupCardStyle}" Width="200" Margin="0,8,0,0">
                                    <StackPanel>
                                        <!-- Tóm tắt tài khoản -->
                                        <StackPanel Margin="10,6,10,8">
                                            <TextBlock Text="Bích Thủy" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDark}"/>
                                            <TextBlock Text="thuy@example.com" FontSize="11" Foreground="{StaticResource TextGray}"/>
                                        </StackPanel>

                                        <Separator Background="{StaticResource PageBg}" Margin="0,0,0,4"/>

                                        <!-- Các nút menu tài khoản dùng đúng MenuItemButton -->
                                        <Button Style="{StaticResource MenuItemButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="👤" Margin="0,0,10,0"/>
                                                <TextBlock Text="Hồ sơ cá nhân"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Style="{StaticResource MenuItemButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🔒" Margin="0,0,10,0"/>
                                                <TextBlock Text="Đổi mật khẩu"/>
                                            </StackPanel>
                                        </Button>

                                        <Separator Background="{StaticResource PageBg}" Margin="0,4"/>

                                        <Button Style="{StaticResource MenuItemButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🚪" Margin="0,0,10,0"/>
                                                <TextBlock Text="Đăng xuất" Foreground="#EF4444" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                    </StackPanel>
                </DockPanel>
            </Border>  
        </Grid>
    </Grid>
</Window>
