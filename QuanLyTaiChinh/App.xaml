<Application x:Class="QuanLyTaiChinh.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QuanLyTaiChinh"
             xmlns:conv="clr-namespace:QuanLyTaiChinh.Converters"
             StartupUri="MainWindow.xaml">

    <Application.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:StringEqualsConverter x:Key="StringEqualsConverter"/>
            <conv:TransactionAmountConverter x:Key="TransactionAmountConverter"/>
            <conv:TransactionTypeColorConverter x:Key="TransactionTypeColorConverter"/>

            <conv:GoalColorConverter x:Key="GoalColorConverter"/>
            <conv:PercentToGridLengthConverter x:Key="PercentToGridLengthConverter"/>

            <conv:BudgetStatusColorConverter x:Key="BudgetStatusColorConverter"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        </ResourceDictionary>
    </Application.Resources>

</Application>