<Window x:Class="QuanLyTaiChinh.View.TransactionEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm giao dịch mới" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False">

    <Border Style="{StaticResource ModalCardStyle}" Margin="16">
        <StackPanel>

            <!-- Tiêu đề + nút đóng (kéo thanh này để di chuyển cửa sổ) -->
            <Grid Margin="0,0,0,20" Background="Transparent" MouseLeftButtonDown="Header_MouseDown">
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           Style="{StaticResource ModalTitleStyle}" VerticalAlignment="Center"/>
                <Button Content="✕" Style="{StaticResource ModalCloseButton}"
                        HorizontalAlignment="Right" Click="Cancel_Click"/>
            </Grid>

            <!-- Loại giao dịch -->
            <Border Background="#EEF5FC" CornerRadius="14" Padding="5" Margin="0,0,0,18">
                <UniformGrid Columns="3">
                    <RadioButton x:Name="TypeExpense" Style="{StaticResource SegmentPill}" GroupName="TxType"
                                 Content="Chi tiêu" Margin="0,0,4,0"/>
                    <RadioButton x:Name="TypeIncome" Style="{StaticResource SegmentPill}" GroupName="TxType"
                                 Content="Thu nhập" Margin="2,0,2,0"/>
                    <RadioButton x:Name="TypeSaving" Style="{StaticResource SegmentPill}" GroupName="TxType"
                                 Content="Tiết kiệm" Margin="4,0,0,0"/>
                </UniformGrid>
            </Border>

            <TextBlock Text="Tên giao dịch" Style="{StaticResource ModalFieldLabel}"/>
            <TextBox x:Name="NameBox" Style="{StaticResource ModalTextBox}"
                     Tag="VD: Siêu thị, Lương tháng 9..." Margin="0,0,0,14"/>

            <TextBlock Text="Số tiền (VNĐ)" Style="{StaticResource ModalFieldLabel}"/>
            <Grid Margin="0,0,0,14">
                <TextBox x:Name="AmountBox" Style="{StaticResource ModalTextBox}" Tag="0"
                         Padding="14,12,36,12"/>
                <TextBlock Text="đ" Foreground="#94A3B8" FontSize="13" IsHitTestVisible="False"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"/>
            </Grid>

            <!-- Danh mục + Ngày -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Danh mục" Style="{StaticResource ModalFieldLabel}"/>
                    <ComboBox x:Name="CategoryBox" Style="{StaticResource ModalComboBox}"
                              IsEditable="True" TextSearch.TextPath="Content" SelectedIndex="0">
                        <ComboBoxItem Content="Ăn uống"/>
                        <ComboBoxItem Content="Di chuyển"/>
                        <ComboBoxItem Content="Mua sắm"/>
                        <ComboBoxItem Content="Giải trí"/>
                        <ComboBoxItem Content="Sức khỏe"/>
                        <ComboBoxItem Content="Hoá đơn"/>
                        <ComboBoxItem Content="Chi phí nghề"/>
                        <ComboBoxItem Content="Thu nhập"/>
                        <ComboBoxItem Content="Tiết kiệm"/>
                        <ComboBoxItem Content="Khác"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Ngày giao dịch" Style="{StaticResource ModalFieldLabel}"/>
                    <Border Background="{StaticResource PageBg}" CornerRadius="12" MinHeight="46"
                            BorderBrush="{StaticResource ModalInputBorder}" BorderThickness="1.5" Padding="8,0">
                        <DatePicker x:Name="DatePickerCtrl" Style="{StaticResource ModalDatePicker}"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Biểu tượng -->
            <TextBlock Text="Biểu tượng" Style="{StaticResource ModalFieldLabel}"/>
            <WrapPanel x:Name="IconPanel" Margin="0,0,0,10">
                <RadioButton Style="{StaticResource IconTile}" GroupName="TxIcon" Content="🛒" Checked="IconTile_Checked"/>
                <RadioButton Style="{StaticResource IconTile}" GroupName="TxIcon" Content="☕" Checked="IconTile_Checked"/>
                <RadioButton Style="{StaticResource IconTile}" GroupName="TxIcon" Content="🍜" Checked="IconTile_Checked"/>
                <RadioButton Style="{StaticResource IconTile}" GroupName="TxIcon" Content="🎬" Checked="IconTile_Checked"/>
                <RadioButton Style="{StaticResource IconTile}" GroupName="TxIcon" Content="🏥" Checked="IconTile_Checked"/>
                <RadioButton Style="{StaticResource IconTile}" GroupName="TxIcon" Content="🛵" Checked="IconTile_Checked"/>
                <RadioButton Style="{StaticResource IconTile}" GroupName="TxIcon" Content="👕" Checked="IconTile_Checked"/>
                <RadioButton Style="{StaticResource IconTile}" GroupName="TxIcon" Content="📚" Checked="IconTile_Checked"/>
                <RadioButton Style="{StaticResource IconTile}" GroupName="TxIcon" Content="💊" Checked="IconTile_Checked"/>
                <RadioButton Style="{StaticResource IconTile}" GroupName="TxIcon" Content="🎮" Checked="IconTile_Checked"/>
                <RadioButton Style="{StaticResource IconTile}" GroupName="TxIcon" Content="💼" Checked="IconTile_Checked"/>
                <RadioButton Style="{StaticResource IconTile}" GroupName="TxIcon" Content="🏦" Checked="IconTile_Checked"/>
                <RadioButton Style="{StaticResource IconTile}" GroupName="TxIcon" Content="🎨" Checked="IconTile_Checked"/>
                <RadioButton Style="{StaticResource IconTile}" GroupName="TxIcon" Content="💰" Checked="IconTile_Checked"/>
            </WrapPanel>
            <!-- Nguồn sự thật của icon đang chọn (ẩn) -->
            <TextBox x:Name="IconBox" Text="🛒" Visibility="Collapsed" TextChanged="IconBox_TextChanged"/>

            <!-- Nút -->
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Hủy" Width="96"
                        Style="{StaticResource ModalCancelButton}" Click="Cancel_Click"/>
                <Button Grid.Column="2" Content="Lưu giao dịch"
                        Style="{StaticResource ModalPrimaryButton}" Click="Save_Click"/>
            </Grid>

        </StackPanel>
    </Border>
</Window>
