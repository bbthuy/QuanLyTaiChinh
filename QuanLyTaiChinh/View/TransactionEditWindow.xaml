<Window x:Class="QuanLyTaiChinh.View.TransactionEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuanLyTaiChinh.View"
        mc:Ignorable="d"
        Title="TransactionEditWindow" Height="490" Width="800">
    <Grid>
        <StackPanel Margin="24">
            <TextBlock Text="Tên giao dịch" Style="{StaticResource StatLabelStyle}" Margin="0,0,0,6"/>
            <TextBox x:Name="NameBox" Padding="10" Margin="0,0,0,14"/>

            <TextBlock Text="Danh mục" Style="{StaticResource StatLabelStyle}" Margin="0,0,0,6"/>
            <TextBox x:Name="CategoryBox" Padding="10" Margin="0,0,0,14"/>

            <TextBlock Text="Loại giao dịch" Style="{StaticResource StatLabelStyle}" Margin="0,0,0,6"/>
            <ComboBox x:Name="TypeCombo" Padding="10" Margin="0,0,0,14">
                <ComboBoxItem Content="Thu nhập"/>
                <ComboBoxItem Content="Chi tiêu"/>
                <ComboBoxItem Content="Tiết kiệm"/>
            </ComboBox>

            <TextBlock Text="Ngày" Style="{StaticResource StatLabelStyle}" Margin="0,0,0,6"/>
            <DatePicker x:Name="DatePickerCtrl" Padding="10" Margin="0,0,0,14"/>

            <TextBlock Text="Số tiền (VNĐ)" Style="{StaticResource StatLabelStyle}" Margin="0,0,0,6"/>
            <TextBox x:Name="AmountBox" Padding="10" Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy" Padding="16,8" Margin="0,0,10,0"
                    Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                    Click="Cancel_Click"/>
                <Button Content="Lưu" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
