<UserControl x:Class="QuanLyTaiChinh.View.BudgetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:QuanLyTaiChinh.Models">

    <StackPanel>

        <!-- ===== TOP BAR ===== -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Ngân sách" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="{Binding CurrentMonthLabel}" Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>

            <Button Grid.Column="1" Content="+ Thêm ngân sách" Style="{StaticResource PrimaryButton}"
                    Command="{Binding AddBudgetCommand}" VerticalAlignment="Top"/>
        </Grid>

        <!-- ===== LƯỚI 2 CỘT CARD NGÂN SÁCH ===== -->
        <ItemsControl ItemsSource="{Binding Budgets}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:BudgetItem}">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,16,16">
                        <StackPanel>

                            <!-- Hàng trên: icon + danh mục + badge % -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12"
                                        Background="{Binding StatusColor, Converter={StaticResource BudgetStatusColorConverter}, ConverterParameter=Light}">
                                    <TextBlock Text="{Binding Icon}" FontSize="20"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Category}" FontWeight="Bold" FontSize="15"
                                               Foreground="{StaticResource TextDark}"/>
                                    <TextBlock Text="{Binding LimitAmount, StringFormat={}Hạn mức: {0:N0}đ}"
                                               Style="{StaticResource PageSubtitleStyle}"/>
                                </StackPanel>

                                <Border Grid.Column="2" CornerRadius="10" Padding="10,5" VerticalAlignment="Top"
                                        Background="{Binding StatusColor, Converter={StaticResource BudgetStatusColorConverter}, ConverterParameter=Light}">
                                    <TextBlock FontWeight="Bold" FontSize="12"
                                               Foreground="{Binding StatusColor, Converter={StaticResource BudgetStatusColorConverter}, ConverterParameter=Text}"
                                               Text="{Binding Percent, StringFormat={}{0:0}%}"/>
                                </Border>
                            </Grid>

                            <!-- Thanh tiến độ: co giãn theo % thật đã chi (ProgressPercent chặn tối đa 100 để không vỡ layout) -->
                            <Grid Height="10" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding ProgressPercent, Converter={StaticResource PercentToGridLengthConverter}}"/>
                                    <ColumnDefinition Width="{Binding RemainingProgressPercent, Converter={StaticResource PercentToGridLengthConverter}}"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="2" CornerRadius="5" Background="{StaticResource PageBg}"/>
                                <Border Grid.Column="0" CornerRadius="5"
                                        Background="{Binding StatusColor, Converter={StaticResource BudgetStatusColorConverter}, ConverterParameter=Fill}"/>
                            </Grid>

                            <!-- Hàng số liệu: đã chi / hạn mức -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDark}"
                                               Text="{Binding SpentAmount, StringFormat={}{0:N0}đ}"/>
                                    <TextBlock Text="đã chi tháng này" Style="{StaticResource PageSubtitleStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDark}"
                                               HorizontalAlignment="Right"
                                               Text="{Binding LimitAmount, StringFormat={}{0:N0}đ}"/>
                                    <TextBlock Text="hạn mức" Style="{StaticResource PageSubtitleStyle}" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>

                            <!-- Banner cảnh báo / thông báo, màu đổi theo trạng thái -->
                            <Border CornerRadius="10" Padding="12,8" Margin="0,0,0,12"
                                    Background="{Binding StatusColor, Converter={StaticResource BudgetStatusColorConverter}, ConverterParameter=Light}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding StatusIcon}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center"
                                               Foreground="{Binding StatusColor, Converter={StaticResource BudgetStatusColorConverter}, ConverterParameter=Text}"/>
                                </StackPanel>
                            </Border>

                            <!-- Sửa / Xóa ngân sách -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="✏️  Sửa" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        FontSize="12" Foreground="{StaticResource TextGray}" Margin="0,0,16,0"
                                        Command="{Binding DataContext.EditBudgetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="🗑️  Xóa" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        FontSize="12" Foreground="{StaticResource TextRed}"
                                        Command="{Binding DataContext.DeleteBudgetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </StackPanel>
</UserControl>
