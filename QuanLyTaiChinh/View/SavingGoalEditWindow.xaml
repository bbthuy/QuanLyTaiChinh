<Window x:Class="QuanLyTaiChinh.View.SavingGoalEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm mục tiêu mới" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False">

    <Border Style="{StaticResource ModalCardStyle}" Margin="16">
        <StackPanel>

            <Grid Margin="0,0,0,22" Background="Transparent" MouseLeftButtonDown="Header_MouseDown">
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           Style="{StaticResource ModalTitleStyle}" VerticalAlignment="Center"/>
                <Button Content="✕" Style="{StaticResource ModalCloseButton}"
                        HorizontalAlignment="Right" Click="Cancel_Click"/>
            </Grid>

            <TextBlock Text="Tên mục tiêu" Style="{StaticResource ModalFieldLabel}"/>
            <TextBox x:Name="NameBox" Style="{StaticResource ModalTextBox}"
                     Tag="VD: Mua xe máy, Du lịch Nhật Bản..." Margin="0,0,0,14"/>

            <TextBlock Text="Biểu tượng" Style="{StaticResource ModalFieldLabel}"/>
            <WrapPanel x:Name="IconPanel" Margin="0,0,0,10">
                <RadioButton Style="{StaticResource IconTile}" GroupName="GoalIcon" Content="🎯" Checked="IconTile_Checked"/>
                <RadioButton Style="{StaticResource IconTile}" GroupName="GoalIcon" Content="🛵" Checked="IconTile_Checked"/>
                <RadioButton Style="{StaticResource IconTile}" GroupName="GoalIcon" Content="🗾" Checked="IconTile_Checked"/>
                <RadioButton Style="{StaticResource IconTile}" GroupName="GoalIcon" Content="🛡️" Checked="IconTile_Checked"/>
                <RadioButton Style="{StaticResource IconTile}" GroupName="GoalIcon" Content="💻" Checked="IconTile_Checked"/>
                <RadioButton Style="{StaticResource IconTile}" GroupName="GoalIcon" Content="🏠" Checked="IconTile_Checked"/>
                <RadioButton Style="{StaticResource IconTile}" GroupName="GoalIcon" Content="🚗" Checked="IconTile_Checked"/>
                <RadioButton Style="{StaticResource IconTile}" GroupName="GoalIcon" Content="✈️" Checked="IconTile_Checked"/>
                <RadioButton Style="{StaticResource IconTile}" GroupName="GoalIcon" Content="🎓" Checked="IconTile_Checked"/>
                <RadioButton Style="{StaticResource IconTile}" GroupName="GoalIcon" Content="💍" Checked="IconTile_Checked"/>
                <RadioButton Style="{StaticResource IconTile}" GroupName="GoalIcon" Content="📱" Checked="IconTile_Checked"/>
                <RadioButton Style="{StaticResource IconTile}" GroupName="GoalIcon" Content="🏦" Checked="IconTile_Checked"/>
                <RadioButton Style="{StaticResource IconTile}" GroupName="GoalIcon" Content="🎁" Checked="IconTile_Checked"/>
                <RadioButton Style="{StaticResource IconTile}" GroupName="GoalIcon" Content="💰" Checked="IconTile_Checked"/>
            </WrapPanel>
            <TextBox x:Name="IconBox" Text="🎯" Visibility="Collapsed" TextChanged="IconBox_TextChanged"/>

            <!-- Hạn hoàn thành + Màu thẻ -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Hạn hoàn thành" Style="{StaticResource ModalFieldLabel}"/>
                    <TextBox x:Name="DeadlineBox" Style="{StaticResource ModalTextBox}" Tag="VD: 12/2026"/>
                    <CheckBox x:Name="NoDeadlineCheck" Content="Không có hạn (liên tục)" Margin="2,8,0,0"
                              FontSize="12.5" Foreground="{StaticResource TextGray}"
                              Checked="NoDeadlineCheck_Changed" Unchecked="NoDeadlineCheck_Changed"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Màu thẻ" Style="{StaticResource ModalFieldLabel}"/>
                    <ComboBox x:Name="ColorCombo" Style="{StaticResource ModalComboBox}">
                        <ComboBoxItem Content="Xanh dương"/>
                        <ComboBoxItem Content="Tím"/>
                        <ComboBoxItem Content="Xanh lá"/>
                        <ComboBoxItem Content="Cam"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- Đã tích lũy + Mục tiêu -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Đã tích lũy (VNĐ)" Style="{StaticResource ModalFieldLabel}"/>
                    <Grid>
                        <TextBox x:Name="CurrentAmountBox" Style="{StaticResource ModalTextBox}" Tag="0"
                                 Text="0" Padding="14,12,32,12"/>
                        <TextBlock Text="đ" Foreground="#94A3B8" FontSize="13" IsHitTestVisible="False"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Số tiền mục tiêu (VNĐ)" Style="{StaticResource ModalFieldLabel}"/>
                    <Grid>
                        <TextBox x:Name="TargetAmountBox" Style="{StaticResource ModalTextBox}" Tag="0"
                                 Padding="14,12,32,12"/>
                        <TextBlock Text="đ" Foreground="#94A3B8" FontSize="13" IsHitTestVisible="False"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Hủy" Width="96"
                        Style="{StaticResource ModalCancelButton}" Click="Cancel_Click"/>
                <Button Grid.Column="2" Content="Lưu mục tiêu"
                        Style="{StaticResource ModalPrimaryButton}" Click="Save_Click"/>
            </Grid>

        </StackPanel>
    </Border>
</Window>
