<Window x:Class="QuanLyTaiChinh.View.SavingGoalEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuanLyTaiChinh.View"
        mc:Ignorable="d"
        Title="SavingGoalEditWindow" Height="600" Width="800">
    <StackPanel Margin="24">
        <TextBlock Text="Tên mục tiêu" Style="{StaticResource StatLabelStyle}" Margin="0,0,0,6"/>
        <TextBox x:Name="NameBox" Padding="10" Margin="0,0,0,14"/>

        <TextBlock Text="Icon (emoji)" Style="{StaticResource StatLabelStyle}" Margin="0,0,0,6"/>
        <ComboBox x:Name="IconBox" Padding="10" Margin="0,0,0,14" SelectedIndex="0">
            <ComboBoxItem Content="🎯"/>
            <ComboBoxItem Content="💰"/>
            <ComboBoxItem Content="🏠"/>
            <ComboBoxItem Content="🚗"/>
            <ComboBoxItem Content="✈️"/>
            <ComboBoxItem Content="💻"/>
            <ComboBoxItem Content="🎓"/>
            <ComboBoxItem Content="❤️"/>
        </ComboBox>
        

        <TextBlock Text="Hạn hoàn thành (vd: 12/2026)" Style="{StaticResource StatLabelStyle}" Margin="0,0,0,6"/>
        <TextBox x:Name="DeadlineBox" Padding="10" Margin="0,0,0,4"/>
        <CheckBox x:Name="NoDeadlineCheck" Content="Không có hạn (liên tục)" Margin="0,0,0,14"
                  Checked="NoDeadlineCheck_Changed" Unchecked="NoDeadlineCheck_Changed"/>

        <TextBlock Text="Màu thẻ" Style="{StaticResource StatLabelStyle}" Margin="0,0,0,6"/>
        <ComboBox x:Name="ColorCombo" Padding="10" Margin="0,0,0,14">
            <ComboBoxItem Content="Xanh dương"/>
            <ComboBoxItem Content="Tím"/>
            <ComboBoxItem Content="Xanh lá"/>
            <ComboBoxItem Content="Cam"/>
        </ComboBox>

        <TextBlock Text="Đã tích lũy (VNĐ)" Style="{StaticResource StatLabelStyle}" Margin="0,0,0,6"/>
        <TextBox x:Name="CurrentAmountBox" Padding="10" Margin="0,0,0,14" Text="0"/>

        <TextBlock Text="Số tiền mục tiêu (VNĐ)" Style="{StaticResource StatLabelStyle}" Margin="0,0,0,6"/>
        <TextBox x:Name="TargetAmountBox" Padding="10" Margin="0,0,0,20"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Hủy" Padding="16,8" Margin="0,0,10,0"
                    Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                    Click="Cancel_Click"/>
            <Button Content="Lưu" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
