<UserControl x:Class="QuanLyTaiChinh.View.ChatbotWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:QuanLyTaiChinh.Models">

    <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24">

        <!-- ===== BONG CHAO KHI CHUYEN TAB ===== -->
        <Border Style="{StaticResource PopupCardStyle}" Padding="12,8"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,74,10"
                Visibility="{Binding GreetingVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding GreetingText}" FontSize="13" FontWeight="SemiBold"/>
        </Border>

        <!-- ===== KHUNG CHAT (mo rong) ===== -->
        <Border Width="320" Height="460" CornerRadius="18" Background="White"
                Effect="{StaticResource CardShadow}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,80"
                Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="{StaticResource ColorPrimary}"
                        CornerRadius="18,18,0,0" Padding="16,14">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🤖" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Trợ lý tài chính" Foreground="White" FontWeight="Bold" FontSize="14.5"/>
                        </StackPanel>
                        <Button Content="✕" HorizontalAlignment="Right" Background="Transparent"
                                Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="13"
                                Command="{Binding ToggleOpenCommand}"/>
                    </Grid>
                </Border>

                <!-- Hoi thoai -->
                <ScrollViewer Grid.Row="1" Padding="14,10" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ChatMessage}">
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource BotBubbleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFromBot}" Value="False">
                                                    <Setter Property="Background" Value="{StaticResource ColorPrimary}"/>
                                                    <Setter Property="CornerRadius" Value="14,14,2,14"/>
                                                    <Setter Property="Margin" Value="60,4,0,4"/>
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFromBot}" Value="False">
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Nhap so tien cho "Neu toi mua" -->
                <Grid Grid.Row="2" Margin="14,0,14,10"
                      Visibility="{Binding IsAskingAmount, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Padding="10" Margin="0,0,8,0"
                             Text="{Binding AmountInput, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="1" Content="Gửi" Style="{StaticResource PrimaryButton}"
                            Padding="14,8" Command="{Binding SubmitWhatIfAmountCommand}"/>
                </Grid>

                <!-- Cac cau hoi co dinh (2 cot x 3 hang) -->
                <UniformGrid Grid.Row="2" Columns="2" Margin="10,0,10,10"
                             Visibility="{Binding IsAskingAmount, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Button Style="{StaticResource PresetQuestionButton}" Content="💰 Xem số dư" Command="{Binding AskBalanceCommand}"/>
                    <Button Style="{StaticResource PresetQuestionButton}" Content="📊 Phân tích" Command="{Binding AskAnalysisCommand}"/>
                    <Button Style="{StaticResource PresetQuestionButton}" Content="🎯 Mục tiêu" Command="{Binding AskGoalsCommand}"/>
                    <Button Style="{StaticResource PresetQuestionButton}" Content="🧪 Nếu tôi mua" Command="{Binding AskWhatIfCommand}"/>
                    <Button Style="{StaticResource PresetQuestionButton}" Content="📉 Xem chi tiêu" Command="{Binding AskSpendingCommand}"/>
                    <Button Style="{StaticResource PresetQuestionButton}" Content="⚠️ Cảnh báo" Command="{Binding AskWarningsCommand}"/>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- ===== NUT LINH VAT (luon hien, dong day nhe) ===== -->
        <Button Style="{StaticResource MascotButtonStyle}" Command="{Binding ToggleOpenCommand}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button.RenderTransform>
                <TranslateTransform x:Name="MascotTransform"/>
            </Button.RenderTransform>
            <Button.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="MascotTransform"
                                             Storyboard.TargetProperty="Y"
                                             From="0" To="-6" Duration="0:0:1.1">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Button.Triggers>
            <TextBlock Text="🐥" FontSize="28"/>
        </Button>

    </Grid>
</UserControl>
