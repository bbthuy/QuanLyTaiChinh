<UserControl x:Class="QuanLyTaiChinh.View.SavingGoalsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:QuanLyTaiChinh.Models">

    <StackPanel>

        <!-- ===== TOP BAR ===== -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Mục tiêu tiết kiệm" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="Tháng 9, 2026" Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>

            <Button Grid.Column="1" Content="+ Thêm mục tiêu" Style="{StaticResource PrimaryButton}"
                    Command="{Binding AddGoalCommand}" VerticalAlignment="Top"/>
        </Grid>

        <!-- ===== LƯỚI 2 CỘT CARD MỤC TIÊU ===== -->
        <ItemsControl ItemsSource="{Binding Goals}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:SavingGoalItem}">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,16,16">
                        <StackPanel>

                            <!-- Hàng trên: icon + tên + badge % -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12"
                                        Background="{Binding AccentColor, Converter={StaticResource GoalColorConverter}, ConverterParameter=Light}">
                                    <TextBlock Text="{Binding Icon}" FontSize="20"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15"
                                               Foreground="{StaticResource TextDark}"/>
                                    <TextBlock Text="{Binding DeadlineLabel}" Style="{StaticResource PageSubtitleStyle}"/>
                                </StackPanel>

                                <Border Grid.Column="2" CornerRadius="10" Padding="10,5" VerticalAlignment="Top"
                                        Background="{Binding AccentColor, Converter={StaticResource GoalColorConverter}, ConverterParameter=Light}">
                                    <TextBlock FontWeight="Bold" FontSize="12"
                                               Foreground="{Binding AccentColor, Converter={StaticResource GoalColorConverter}, ConverterParameter=Text}"
                                               Text="{Binding Percent, StringFormat={}{0:0}%}"/>
                                </Border>
                            </Grid>

                            <!-- Thanh tiến độ: 2 cột Grid chia theo tỉ lệ %, không phụ thuộc kích thước cửa sổ -->
                            <Grid Height="10" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding Percent, Converter={StaticResource PercentToGridLengthConverter}}"/>
                                    <ColumnDefinition Width="{Binding RemainingPercent, Converter={StaticResource PercentToGridLengthConverter}}"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="2" CornerRadius="5" Background="{StaticResource PageBg}"/>
                                <Border Grid.Column="0" CornerRadius="5"
                                        Background="{Binding AccentColor, Converter={StaticResource GoalColorConverter}, ConverterParameter=Fill}"/>
                            </Grid>

                            <!-- Hàng dưới: đã tích lũy / còn thiếu / mục tiêu -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDark}"
                                               Text="{Binding CurrentAmount, StringFormat={}{0:N0}đ}"/>
                                    <TextBlock Text="đã tích lũy" Style="{StaticResource PageSubtitleStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextRed}"
                                               HorizontalAlignment="Center"
                                               Text="{Binding RemainingAmount, StringFormat={}{0:N0}đ}"/>
                                    <TextBlock Text="còn thiếu" Style="{StaticResource PageSubtitleStyle}" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                    <TextBlock FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDark}"
                                               HorizontalAlignment="Right"
                                               Text="{Binding TargetAmount, StringFormat={}{0:N0}đ}"/>
                                    <TextBlock Text="mục tiêu" Style="{StaticResource PageSubtitleStyle}" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>

                            <!-- Sửa / Xóa mục tiêu -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                                <Button Content="✏️  Sửa" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        FontSize="12" Foreground="{StaticResource TextGray}" Margin="0,0,16,0"
                                        Command="{Binding DataContext.EditGoalCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="🗑️  Xóa" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        FontSize="12" Foreground="{StaticResource TextRed}"
                                        Command="{Binding DataContext.DeleteGoalCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </StackPanel>
</UserControl>
