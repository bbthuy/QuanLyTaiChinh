<Window x:Class="QuanLyTaiChinh.View.BudgetEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thiết lập ngân sách" Height="500" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource PageBg}"
        WindowStyle="ToolWindow">

    <Border Padding="32">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Thiết lập ngân sách" 
                       FontSize="22" FontWeight="SemiBold" 
                       Foreground="#111827" Margin="0,0,0,24"/>

            <StackPanel Grid.Row="1">
                <TextBlock Text="Danh mục chi tiêu" Style="{StaticResource StatLabelStyle}" Margin="0,0,0,8"/>
                <ComboBox x:Name="CategoryCombo" Padding="12" Margin="0,0,0,20" IsEditable="True" FontSize="15">
                    <ComboBoxItem Content="Ăn uống"/>
                    <ComboBoxItem Content="Di chuyển"/>
                    <ComboBoxItem Content="Mua sắm"/>
                    <ComboBoxItem Content="Giải trí"/>
                    <ComboBoxItem Content="Sức khỏe"/>
                    <ComboBoxItem Content="Hoá đơn"/>
                    <ComboBoxItem Content="Chi phí nghề"/>
                    <ComboBoxItem Content="Khác"/>
                </ComboBox>

                <TextBlock Text="Biểu tượng (Icon)" Style="{StaticResource StatLabelStyle}" Margin="0,0,0,8"/>
                <ComboBox x:Name="IconBox" Padding="12" Margin="0,0,0,20" FontSize="16" SelectedIndex="0">
                    <ComboBoxItem Content="💰"/>
                    <ComboBoxItem Content="🍔 "/>
                    <ComboBoxItem Content="🚗 "/>
                    <ComboBoxItem Content="🛍️ "/>
                    <ComboBoxItem Content="🎮 "/>
                    <ComboBoxItem Content="💊 "/>
                    <ComboBoxItem Content="🧾 "/>
                    <ComboBoxItem Content="💼 "/>
                    <ComboBoxItem Content="✨ Khác"/>
                </ComboBox>

                <TextBlock Text="Hạn mức tháng này (VNĐ)" Style="{StaticResource StatLabelStyle}" Margin="0,0,0,8"/>
                <TextBox x:Name="LimitAmountBox" Padding="12" Margin="0,0,0,12" FontSize="15"/>

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource TextRed}" FontSize="13"
                           TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Hủy bỏ" Padding="0,12"
                        Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                        Foreground="#4B5563" FontSize="14" FontWeight="Medium"
                        Click="Cancel_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="2" Content="Lưu thông tin" Padding="0,12"
                        Style="{StaticResource PrimaryButton}" FontSize="14" FontWeight="Medium" 
                        Click="Save_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>