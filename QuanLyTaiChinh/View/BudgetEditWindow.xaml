<Window x:Class="QuanLyTaiChinh.View.BudgetEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm ngân sách" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False">

    <Border Style="{StaticResource ModalCardStyle}" Margin="16">
        <StackPanel>

            <Grid Margin="0,0,0,22" Background="Transparent" MouseLeftButtonDown="Header_MouseDown">
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           Style="{StaticResource ModalTitleStyle}" VerticalAlignment="Center"/>
                <Button Content="✕" Style="{StaticResource ModalCloseButton}"
                        HorizontalAlignment="Right" Click="Cancel_Click"/>
            </Grid>

            <TextBlock Text="Danh mục" Style="{StaticResource ModalFieldLabel}"/>
            <ComboBox x:Name="CategoryCombo" Style="{StaticResource ModalComboBox}"
                      IsEditable="True" TextSearch.TextPath="Content" Margin="0,0,0,16">
                <ComboBoxItem Content="Ăn uống"/>
                <ComboBoxItem Content="Di chuyển"/>
                <ComboBoxItem Content="Mua sắm"/>
                <ComboBoxItem Content="Giải trí"/>
                <ComboBoxItem Content="Sức khỏe"/>
                <ComboBoxItem Content="Hoá đơn"/>
                <ComboBoxItem Content="Chi phí nghề"/>
                <ComboBoxItem Content="Khác"/>
            </ComboBox>

            <TextBlock Text="Biểu tượng" Style="{StaticResource ModalFieldLabel}"/>
            <WrapPanel x:Name="IconPanel" Margin="0,0,0,10">
                <RadioButton Style="{StaticResource IconTile}" GroupName="BudgetIcon" Content="🍜" Checked="IconTile_Checked"/>
                <RadioButton Style="{StaticResource IconTile}" GroupName="BudgetIcon" Content="🛵" Checked="IconTile_Checked"/>
                <RadioButton Style="{StaticResource IconTile}" GroupName="BudgetIcon" Content="🎬" Checked="IconTile_Checked"/>
                <RadioButton Style="{StaticResource IconTile}" GroupName="BudgetIcon" Content="🏥" Checked="IconTile_Checked"/>
                <RadioButton Style="{StaticResource IconTile}" GroupName="BudgetIcon" Content="🛒" Checked="IconTile_Checked"/>
                <RadioButton Style="{StaticResource IconTile}" GroupName="BudgetIcon" Content="☕" Checked="IconTile_Checked"/>
                <RadioButton Style="{StaticResource IconTile}" GroupName="BudgetIcon" Content="👕" Checked="IconTile_Checked"/>
                <RadioButton Style="{StaticResource IconTile}" GroupName="BudgetIcon" Content="📚" Checked="IconTile_Checked"/>
                <RadioButton Style="{StaticResource IconTile}" GroupName="BudgetIcon" Content="💊" Checked="IconTile_Checked"/>
                <RadioButton Style="{StaticResource IconTile}" GroupName="BudgetIcon" Content="🎮" Checked="IconTile_Checked"/>
                <RadioButton Style="{StaticResource IconTile}" GroupName="BudgetIcon" Content="🏠" Checked="IconTile_Checked"/>
                <RadioButton Style="{StaticResource IconTile}" GroupName="BudgetIcon" Content="💡" Checked="IconTile_Checked"/>
                <RadioButton Style="{StaticResource IconTile}" GroupName="BudgetIcon" Content="📱" Checked="IconTile_Checked"/>
                <RadioButton Style="{StaticResource IconTile}" GroupName="BudgetIcon" Content="💰" Checked="IconTile_Checked"/>
            </WrapPanel>
            <TextBox x:Name="IconBox" Text="💰" Visibility="Collapsed" TextChanged="IconBox_TextChanged"/>

            <TextBlock Text="Hạn mức tháng này (VNĐ)" Style="{StaticResource ModalFieldLabel}"/>
            <Grid Margin="0,0,0,12">
                <TextBox x:Name="LimitAmountBox" Style="{StaticResource ModalTextBox}" Tag="0"
                         Padding="14,12,36,12"/>
                <TextBlock Text="đ" Foreground="#94A3B8" FontSize="13" IsHitTestVisible="False"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"/>
            </Grid>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource TextRed}" FontSize="12.5"
                       TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed"/>

            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Hủy" Width="96"
                        Style="{StaticResource ModalCancelButton}" Click="Cancel_Click"/>
                <Button Grid.Column="2" Content="Lưu ngân sách"
                        Style="{StaticResource ModalPrimaryButton}" Click="Save_Click"/>
            </Grid>

        </StackPanel>
    </Border>
</Window>
