<UserControl x:Class="QuanLyTaiChinh.View.Auth.ChangePasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3FAFD">

    <Grid>

        <Border Width="500"
                Padding="45"
                CornerRadius="20"
                Background="White"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <Border Width="72"
                        Height="72"
                        CornerRadius="36"
                        Background="#E8F6FD"
                        HorizontalAlignment="Center">

                    <TextBlock Text="🔒"
                               FontSize="30"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Đổi mật khẩu"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#17344A"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0"/>

                <TextBlock Text="Cập nhật mật khẩu để bảo vệ tài khoản FinanceWise của bạn."
                           Foreground="#819DAD"
                           FontSize="14"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,10,0,30"/>

                <!-- CURRENT PASSWORD -->
                <TextBlock Text="Mật khẩu hiện tại"
                           Foreground="#37566B"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <Border Height="50"
                        CornerRadius="10"
                        BorderBrush="#C6E3F2"
                        BorderThickness="1"
                        Background="#F7FCFF">

                    <PasswordBox x:Name="txtCurrentPassword"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="14,10"
                                 FontSize="14"/>
                </Border>

                <!-- NEW PASSWORD -->
                <TextBlock Text="Mật khẩu mới"
                           Foreground="#37566B"
                           FontWeight="SemiBold"
                           Margin="0,18,0,8"/>

                <Border Height="50"
                        CornerRadius="10"
                        BorderBrush="#C6E3F2"
                        BorderThickness="1"
                        Background="#F7FCFF">

                    <PasswordBox x:Name="txtNewPassword"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="14,10"
                                 FontSize="14"/>
                </Border>

                <!-- CONFIRM PASSWORD -->
                <TextBlock Text="Xác nhận mật khẩu mới"
                           Foreground="#37566B"
                           FontWeight="SemiBold"
                           Margin="0,18,0,8"/>

                <Border Height="50"
                        CornerRadius="10"
                        BorderBrush="#C6E3F2"
                        BorderThickness="1"
                        Background="#F7FCFF">

                    <PasswordBox x:Name="txtConfirmPassword"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="14,10"
                                 FontSize="14"/>
                </Border>

                <TextBlock Text="Mật khẩu nên có ít nhất 8 ký tự."
                           Foreground="#94AAB8"
                           FontSize="12"
                           Margin="0,10,0,0"/>

                <!-- UPDATE BUTTON -->
                <Button Content="Cập nhật mật khẩu"
                        Height="50"
                        Margin="0,26,0,0"
                        Background="#4DA5D2"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="15"
                        Cursor="Hand"
                        Click="ChangePassword_Click"/>

                <!-- BACK -->
                <Button Content="← Quay lại"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#7895A7"
                        Margin="0,17,0,0"
                        Cursor="Hand"
                        Click="Back_Click"/>

            </StackPanel>

        </Border>

    </Grid>
</UserControl>