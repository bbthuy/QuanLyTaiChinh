<UserControl x:Class="QuanLyTaiChinh.View.Auth.VerifyResetCodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuanLyTaiChinh.View.Auth"
                          Background="#F3FAFD">

    <Grid>

        <Border Width="470"
                Padding="45"
                CornerRadius="20"
                Background="White"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <TextBlock Text="Xác nhận mã OTP"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#17344A"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Nhập mã gồm 6 chữ số đã được gửi đến email của bạn."
                           Foreground="#819DAD"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,10,0,28"/>

                <Border Height="55"
                        CornerRadius="10"
                        BorderBrush="#BFE1F2"
                        BorderThickness="1">

                    <TextBox x:Name="txtOtp"
                             MaxLength="6"
                             BorderThickness="0"
                             Background="Transparent"
                             TextAlignment="Center"
                             FontSize="22"
                             FontWeight="SemiBold"
                             VerticalContentAlignment="Center"/>
                </Border>

                <TextBlock Text="Mã có hiệu lực trong 05:00"
                           Foreground="#94AAB8"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"/>

                <Button Content="Tiếp tục"
                        Height="50"
                        Margin="0,25,0,0"
                        Background="#4DA5D2"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="Continue_Click"/>

                <Button Content="Gửi lại mã"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#3E9DCE"
                        Margin="0,15,0,0"/>

            </StackPanel>

        </Border>

    </Grid>
</UserControl>