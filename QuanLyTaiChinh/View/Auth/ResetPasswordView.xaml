<UserControl x:Class="QuanLyTaiChinh.View.Auth.ResetPasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuanLyTaiChinh.View.Auth"
                          Background="#F3FAFD">

    <Grid>

        <Border Width="470"
                Padding="45"
                CornerRadius="20"
                Background="White"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <TextBlock Text="Đặt mật khẩu mới"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#17344A"/>

                <TextBlock Text="Mật khẩu mới nên có ít nhất 8 ký tự."
                           Foreground="#819DAD"
                           Margin="0,8,0,28"/>

                <TextBlock Text="Mật khẩu mới"
                           FontWeight="SemiBold"
                           Foreground="#37566B"
                           Margin="0,0,0,8"/>

                <Border Height="50"
                        CornerRadius="10"
                        BorderBrush="#C6E3F2"
                        BorderThickness="1">

                    <PasswordBox x:Name="txtNewPassword"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="14,10"/>
                </Border>

                <TextBlock Text="Xác nhận mật khẩu mới"
                           FontWeight="SemiBold"
                           Foreground="#37566B"
                           Margin="0,18,0,8"/>

                <Border Height="50"
                        CornerRadius="10"
                        BorderBrush="#C6E3F2"
                        BorderThickness="1">

                    <PasswordBox x:Name="txtConfirmPassword"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="14,10"/>
                </Border>

                <Button Content="Đặt lại mật khẩu"
        Height="50"
        Margin="0,26,0,0"
        Foreground="White"
        BorderThickness="0"
        FontWeight="Bold"
        FontSize="15"
        Cursor="Hand"
        Click="Reset_Click">

                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#7DC8E8"/>

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">

                                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="25">

                                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#64B8DE"/>
                                            </Trigger>

                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#4FA3CC"/>
                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>

                        </Style>
                    </Button.Style>

                </Button>

            </StackPanel>

        </Border>

    </Grid>
</UserControl>