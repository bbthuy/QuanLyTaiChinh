<UserControl x:Class="QuanLyTaiChinh.View.Auth.VerifyEmailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuanLyTaiChinh.View.Auth"
                          Background="#F3FAFD">

    <Grid>

        <Border Width="470"
                Padding="45"
                CornerRadius="20"
                Background="White"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <Border Width="75"
                        Height="75"
                        CornerRadius="37"
                        Background="#E7F6FD"
                        HorizontalAlignment="Center">

                    <TextBlock Text="✉"
                               FontSize="32"
                               Foreground="#4DA5D2"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Xác minh email"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#17344A"
                           HorizontalAlignment="Center"
                           Margin="0,22,0,0"/>

                <TextBlock Text="Chúng tôi đã gửi mã xác nhận 6 số đến email của bạn."
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="#819DAD"
                           FontSize="14"
                           Margin="0,10,0,28"/>

                <TextBlock Text="Mã xác nhận"
                           FontWeight="SemiBold"
                           Foreground="#37566B"
                           Margin="0,0,0,8"/>

                <Border Height="55"
                        CornerRadius="10"
                        BorderBrush="#BFE1F2"
                        BorderThickness="1"
                        Background="#F8FCFE">

                    <TextBox x:Name="txtOtp"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="22"
                             FontWeight="SemiBold"
                             MaxLength="6"
                             TextAlignment="Center"
                             VerticalContentAlignment="Center"/>
                </Border>

                <TextBlock x:Name="txtCountdown"
                           Text="Đang tải thời gian..."
                           Foreground="#94AAB8"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"/>

                <Button Content="Xác nhận"
        Height="50"
        Margin="0,26,0,0"
        Foreground="White"
        BorderThickness="0"
        FontWeight="Bold"
        FontSize="15"
        Cursor="Hand"
        Click="Verify_Click">

                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#7DC8E8"/>

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">

                                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="25">

                                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#64B8DE"/>
                                            </Trigger>

                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#4FA3CC"/>
                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>

                        </Style>
                    </Button.Style>

                </Button>


                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,18,0,0">

                    <TextBlock Text="Không nhận được mã?"
                               Foreground="#829AA9"/>

                    <Button Content="Gửi lại mã"
        Click="Resend_Click"
        Margin="5,0,0,0"
        BorderThickness="0"
        Background="Transparent"
        Foreground="#3E9DCE"
        FontWeight="SemiBold"
        Cursor="Hand"/>
                </StackPanel>

                <Button Content="← Quay lại đăng nhập"
                        Margin="0,14,0,0"
                        BorderThickness="0"
                        Background="Transparent"
                        Foreground="#7895A7"
                        Cursor="Hand"
                        Click="Back_Click"/>

            </StackPanel>

        </Border>

    </Grid>
</UserControl>