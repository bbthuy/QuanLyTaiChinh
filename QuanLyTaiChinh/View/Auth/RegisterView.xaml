<UserControl x:Class="QuanLyTaiChinh.View.Auth.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuanLyTaiChinh.View.Auth"
                          Background="White">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="55*"/>
            <ColumnDefinition Width="45*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT -->
        <Grid Grid.Column="0">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#41658A" Offset="0"/>
                    <GradientStop Color="#59A9D4" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <StackPanel Margin="55">

                <StackPanel Orientation="Horizontal">
                    <Border Width="48"
                            Height="48"
                            CornerRadius="12"
                            BorderBrush="#90C4E1"
                            BorderThickness="1"
                            Background="#40FFFFFF">
                        <TextBlock Text="$"
                                   Foreground="White"
                                   FontSize="25"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="12,2,0,0">
                        <TextBlock Text="FinanceWise"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="20"/>
                        <TextBlock Text="Quản lý tài chính thông minh"
                                   Foreground="#CDE8F7"
                                   FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Margin="0,115,0,0">
                    <TextBlock Text="Bắt đầu hành trình"
                               Foreground="White"
                               FontSize="37"
                               FontWeight="Bold"/>

                    <TextBlock Text="tài chính thông minh"
                               Foreground="#A9D5EE"
                               FontSize="37"
                               FontWeight="Bold"/>

                    <TextBlock Margin="0,20,0,0"
                               Width="470"
                               HorizontalAlignment="Left"
                               TextWrapping="Wrap"
                               LineHeight="25"
                               Foreground="#DCEEF8"
                               FontSize="16"
                               Text="Tạo tài khoản FinanceWise và bắt đầu quản lý thu nhập, chi tiêu, ngân sách và mục tiêu của bạn."/>
                </StackPanel>

                <Border Margin="0,75,0,0"
                        Padding="25"
                        CornerRadius="18"
                        BorderBrush="#70C3E9"
                        BorderThickness="1"
                        Background="#18FFFFFF">

                    <StackPanel>
                        <TextBlock Text="✓ Theo dõi thu chi dễ dàng"
                                   Foreground="White"
                                   FontSize="15"
                                   Margin="0,4"/>

                        <TextBlock Text="✓ Quản lý ngân sách thông minh"
                                   Foreground="White"
                                   FontSize="15"
                                   Margin="0,4"/>

                        <TextBlock Text="✓ Lập mục tiêu tiết kiệm"
                                   Foreground="White"
                                   FontSize="15"
                                   Margin="0,4"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>

        <!-- RIGHT -->
        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Width="420"
                        VerticalAlignment="Center"
                        Margin="0,55">

                <TextBlock Text="Tạo tài khoản"
                           FontSize="31"
                           FontWeight="Bold"
                           Foreground="#122B3E"/>

                <TextBlock Text="Bắt đầu quản lý tài chính cùng FinanceWise"
                           Foreground="#86A4B7"
                           FontSize="14"
                           Margin="0,7,0,30"/>

                <TextBlock Text="Họ và tên"
                           Foreground="#37566B"
                           FontWeight="SemiBold"
                           Margin="0,0,0,7"/>

                <Border Height="48"
                        CornerRadius="10"
                        BorderBrush="#C6E3F2"
                        BorderThickness="1"
                        Background="#F7FCFF">
                    <TextBox x:Name="txtFullName"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="14,10"
                             FontSize="14"/>
                </Border>

                <TextBlock Text="Địa chỉ email"
                           Foreground="#37566B"
                           FontWeight="SemiBold"
                           Margin="0,17,0,7"/>

                <Border Height="48"
                        CornerRadius="10"
                        BorderBrush="#C6E3F2"
                        BorderThickness="1"
                        Background="#F7FCFF">
                    <TextBox x:Name="txtEmail"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="14,10"
                             FontSize="14"/>
                </Border>

                <TextBlock Text="Mật khẩu"
                           Foreground="#37566B"
                           FontWeight="SemiBold"
                           Margin="0,17,0,7"/>

                <Border Height="48"
                        CornerRadius="10"
                        BorderBrush="#C6E3F2"
                        BorderThickness="1"
                        Background="#F7FCFF">
                    <PasswordBox x:Name="txtPassword"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="14,10"
                                 FontSize="14"/>
                </Border>

                <TextBlock Text="Xác nhận mật khẩu"
                           Foreground="#37566B"
                           FontWeight="SemiBold"
                           Margin="0,17,0,7"/>

                <Border Height="48"
                        CornerRadius="10"
                        BorderBrush="#C6E3F2"
                        BorderThickness="1"
                        Background="#F7FCFF">
                    <PasswordBox x:Name="txtConfirmPassword"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="14,10"
                                 FontSize="14"/>
                </Border>

                <CheckBox Margin="0,18,0,0"
                          Foreground="#7895A7">
                    <TextBlock TextWrapping="Wrap">
                        Tôi đồng ý với Điều khoản sử dụng và Chính sách bảo mật
                    </TextBlock>
                </CheckBox>

                <Button Height="50"
                        Margin="0,25,0,0"
                        Background="#4DA5D2"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="15"
                        Cursor="Hand"
                        Content="Đăng ký"
                        Click="Register_Click"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,22,0,0">

                    <TextBlock Text="Đã có tài khoản?"
                               Foreground="#7895A7"/>

                    <Button Content="Đăng nhập"
                            Margin="5,0,0,0"
                            BorderThickness="0"
                            Background="Transparent"
                            Foreground="#3E9DCE"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="Login_Click"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
