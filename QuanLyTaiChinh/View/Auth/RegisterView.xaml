<UserControl x:Class="QuanLyTaiChinh.View.Auth.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#EEF1F5">

    <Grid Background="#EEF1F5">

        <Border Width="1150"
                Height="Auto"
                Background="White"
                CornerRadius="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect BlurRadius="25"
                                  ShadowDepth="0"
                                  Opacity="0.12"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="0.95*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT FORM -->
                <Grid Grid.Column="0"
                      Margin="55,35,55,35">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- LOGO -->
                    <StackPanel Orientation="Horizontal">

                        <Border Width="40"
                                Height="40"
                                CornerRadius="12"
                                Background="#1F3442">

                            <TextBlock Text="$"
                                       Foreground="White"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Margin="12,0,0,0">

                            <TextBlock Text="FinanceWise"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#1F3442"/>

                            <TextBlock Text="Quản lý tài chính thông minh"
                                       FontSize="12"
                                       Foreground="#7C97A8"/>
                        </StackPanel>

                    </StackPanel>


                    <!-- FORM -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">

                        <StackPanel VerticalAlignment="Center"
                                    Margin="0,28,0,0">

                            <TextBlock Text="Tạo tài khoản mới ✨"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="#1F3442"/>

                            <TextBlock Text="Đăng ký để bắt đầu quản lý tài chính của bạn"
                                       FontSize="14"
                                       Foreground="#7C97A8"
                                       Margin="0,8,0,22"/>

                            <!-- LOGIN / REGISTER SWITCH -->
                            <Border Background="#F2F6F8"
                                    CornerRadius="14"
                                    Padding="6"
                                    Margin="0,0,0,22">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Content="Đăng nhập"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="#6B7280"
                                            FontSize="14"
                                            Cursor="Hand"
                                            Click="Login_Click"/>

                                    <Border Grid.Column="1"
                                            Background="White"
                                            CornerRadius="12">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10"
                                                              ShadowDepth="0"
                                                              Opacity="0.08"/>
                                        </Border.Effect>
                                    </Border>

                                    <Button Grid.Column="1"
                                            Content="Đăng ký"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="#5FB3DA"
                                            FontWeight="SemiBold"
                                            FontSize="14"/>
                                </Grid>

                            </Border>


                            <!-- FULL NAME -->
                            <TextBlock Text="Họ và tên"
                                       Foreground="#37566B"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <Border Height="52"
                                    CornerRadius="14"
                                    BorderBrush="#CBE7F4"
                                    BorderThickness="1"
                                    Background="#FDFEFE"
                                    Margin="0,0,0,16">

                                <Grid Margin="14,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="👤"
                                               VerticalAlignment="Center"
                                               FontSize="15"
                                               Foreground="#7C97A8"/>

                                    <TextBox x:Name="txtFullName"
                                             Grid.Column="1"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontSize="14"
                                             VerticalContentAlignment="Center"/>
                                </Grid>
                            </Border>


                            <!-- EMAIL -->
                            <TextBlock Text="Địa chỉ email"
                                       Foreground="#37566B"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <Border Height="52"
                                    CornerRadius="14"
                                    BorderBrush="#CBE7F4"
                                    BorderThickness="1"
                                    Background="#FDFEFE"
                                    Margin="0,0,0,16">

                                <Grid Margin="14,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="✉"
                                               VerticalAlignment="Center"
                                               FontSize="15"
                                               Foreground="#7C97A8"/>

                                    <TextBox x:Name="txtEmail"
                                             Grid.Column="1"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontSize="14"
                                             VerticalContentAlignment="Center"/>
                                </Grid>
                            </Border>


                            <!-- PASSWORD -->
                            <TextBlock Text="Mật khẩu"
                                       Foreground="#37566B"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <Border Height="52"
                                    CornerRadius="14"
                                    BorderBrush="#CBE7F4"
                                    BorderThickness="1"
                                    Background="#FDFEFE"
                                    Margin="0,0,0,16">

                                <Grid Margin="14,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="🔒"
                                               VerticalAlignment="Center"
                                               FontSize="15"
                                               Foreground="#7C97A8"/>

                                    <PasswordBox x:Name="txtPassword"
                                                 Grid.Column="1"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 FontSize="14"
                                                 VerticalContentAlignment="Center"/>
                                </Grid>
                            </Border>


                            <!-- CONFIRM -->
                            <TextBlock Text="Xác nhận mật khẩu"
                                       Foreground="#37566B"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <Border Height="52"
                                    CornerRadius="14"
                                    BorderBrush="#CBE7F4"
                                    BorderThickness="1"
                                    Background="#FDFEFE">

                                <Grid Margin="14,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="🔐"
                                               VerticalAlignment="Center"
                                               FontSize="15"
                                               Foreground="#7C97A8"/>

                                    <PasswordBox x:Name="txtConfirmPassword"
                                                 Grid.Column="1"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 FontSize="14"
                                                 VerticalContentAlignment="Center"/>
                                </Grid>
                            </Border>


                            <!-- PASSWORD NOTE -->
                            <TextBlock Text="Mật khẩu nên có ít nhất 8 ký tự"
                                       Foreground="#94AAB8"
                                       FontSize="12"
                                       Margin="0,8,0,14"/>


                            <!-- TERMS -->
                            <CheckBox x:Name="chkTerms"
                                      Foreground="#6B7280"
                                      Margin="0,0,0,20">

                                <TextBlock TextWrapping="Wrap">
                                    Tôi đồng ý với Điều khoản sử dụng và Chính sách bảo mật
                                </TextBlock>
                            </CheckBox>


                            <!-- REGISTER BUTTON -->
                            <Button Content="Đăng ký"
                                    Height="54"
                                    Foreground="White"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="Register_Click">

                                <Button.Style>
                                    <Style TargetType="Button">

                                        <Setter Property="Background"
                                                Value="#6FBFE3"/>

                                        <Setter Property="Template">
                                            <Setter.Value>

                                                <ControlTemplate TargetType="Button">

                                                    <Border x:Name="border"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="14">

                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>

                                                    <ControlTemplate.Triggers>

                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                            <Setter TargetName="border"
                                                                    Property="Background"
                                                                    Value="#5EB2D8"/>
                                                        </Trigger>

                                                        <Trigger Property="IsPressed"
                                                                 Value="True">
                                                            <Setter TargetName="border"
                                                                    Property="Background"
                                                                    Value="#52A4CB"/>
                                                        </Trigger>

                                                    </ControlTemplate.Triggers>

                                                </ControlTemplate>

                                            </Setter.Value>
                                        </Setter>

                                    </Style>
                                </Button.Style>

                            </Button>


                            <!-- BACK LOGIN -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,18,0,0">

                                <TextBlock Text="Đã có tài khoản?"
                                           Foreground="#7C97A8"
                                           VerticalAlignment="Center"/>

                                <Button Content="Đăng nhập"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="#5FB3DA"
                                        FontWeight="SemiBold"
                                        Margin="4,0,0,0"
                                        Cursor="Hand"
                                        Click="Login_Click"/>
                            </StackPanel>

                        </StackPanel>

                    </ScrollViewer>

                </Grid>


                <!-- RIGHT IMAGE -->
                <Grid Grid.Column="1">

                    <Border CornerRadius="0,24,24,0">

                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="1,1">

                                <GradientStop Color="#EEF8FD"
                                              Offset="0"/>

                                <GradientStop Color="#D8EFFA"
                                              Offset="0.5"/>

                                <GradientStop Color="#A9DDF2"
                                              Offset="1"/>

                            </LinearGradientBrush>
                        </Border.Background>

                    </Border>


                    <Grid Grid.Column="1">

                        <Border CornerRadius="0,24,24,0"
            ClipToBounds="True">

                            <Image Source="/Assets/Images/safe.jpg"
               Stretch="UniformToFill"/>
                        </Border>

                    </Grid>
                </Grid>

            </Grid>

        </Border>

    </Grid>

</UserControl>