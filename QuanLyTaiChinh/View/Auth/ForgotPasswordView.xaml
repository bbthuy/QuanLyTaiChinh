<UserControl x:Class="QuanLyTaiChinh.View.Auth.ForgotPasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#EEF1F5">

    <Grid Background="#EEF1F5">

        <Border Width="1150"
                Height="600"
                Background="White"
                CornerRadius="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect BlurRadius="25"
                                  ShadowDepth="0"
                                  Opacity="0.12"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="0.95*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT FORM -->
                <Grid Grid.Column="0"
                      Margin="55,45">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- LOGO -->
                    <StackPanel Orientation="Horizontal">

                        <Border Width="40"
                                Height="40"
                                CornerRadius="12"
                                Background="#1F3442">

                            <TextBlock Text="$"
                                       Foreground="White"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="FinanceWise"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#1F3442"/>

                            <TextBlock Text="Quản lý tài chính thông minh"
                                       FontSize="12"
                                       Foreground="#7C97A8"/>
                        </StackPanel>

                    </StackPanel>


                    <!-- CONTENT -->
                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center">

                        <Border Width="72"
                                Height="72"
                                CornerRadius="36"
                                Background="#EAF7FC"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,20">

                            <TextBlock Text="🔑"
                                       FontSize="28"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Quên mật khẩu?"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#1F3442"/>

                        <TextBlock Text="Nhập email đã đăng ký. Chúng tôi sẽ gửi mã OTP để bạn đặt lại mật khẩu."
                                   FontSize="14"
                                   Foreground="#7C97A8"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,10,0,28"/>

                        <TextBlock Text="Địa chỉ email"
                                   Foreground="#37566B"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <Border Height="54"
                                CornerRadius="14"
                                BorderBrush="#CBE7F4"
                                BorderThickness="1"
                                Background="#FDFEFE">

                            <Grid Margin="14,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="✉"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           Foreground="#7C97A8"/>

                                <TextBox x:Name="txtEmail"
                                         Grid.Column="1"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="14"
                                         VerticalContentAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Button Content="Gửi mã OTP"
                                Height="54"
                                Margin="0,26,0,0"
                                Foreground="White"
                                FontSize="16"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="SendOtp_Click">

                            <Button.Style>
                                <Style TargetType="Button">

                                    <Setter Property="Background"
                                            Value="#6FBFE3"/>

                                    <Setter Property="Template">
                                        <Setter.Value>

                                            <ControlTemplate TargetType="Button">

                                                <Border x:Name="border"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="14">

                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>

                                                <ControlTemplate.Triggers>

                                                    <Trigger Property="IsMouseOver"
                                                             Value="True">
                                                        <Setter TargetName="border"
                                                                Property="Background"
                                                                Value="#5EB2D8"/>
                                                    </Trigger>

                                                    <Trigger Property="IsPressed"
                                                             Value="True">
                                                        <Setter TargetName="border"
                                                                Property="Background"
                                                                Value="#52A4CB"/>
                                                    </Trigger>

                                                </ControlTemplate.Triggers>

                                            </ControlTemplate>

                                        </Setter.Value>
                                    </Setter>

                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="← Quay lại đăng nhập"
                                Margin="0,20,0,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#5FB3DA"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="Back_Click"/>

                    </StackPanel>

                </Grid>


                <!-- RIGHT IMAGE -->
                <Grid Grid.Column="1">

                    <Border CornerRadius="0,24,24,0"
                            ClipToBounds="True">

                        <Image Source="/Assets/Images/safe.jpg"
                               Stretch="UniformToFill"/>
                    </Border>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</UserControl>