<UserControl x:Class="QuanLyTaiChinh.View.Auth.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#EEF1F5">

    <Grid Background="#EEF1F5">
        <Border Width="1150"
                Height="auto"
                Background="White"
                CornerRadius="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25"
                                  ShadowDepth="0"
                                  Opacity="0.12"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="0.95*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDE -->
                <Grid Grid.Column="0" Margin="55,40,55,40">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Logo -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                        <Border Width="40" Height="40" CornerRadius="12" Background="#111827">
                            <TextBlock Text="$"
                                       Foreground="White"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="FinanceWise"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#111827"/>
                            <TextBlock Text="Quản lý tài chính thông minh"
                                       FontSize="12"
                                       Foreground="#6B7280"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Form -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="Chào mừng trở lại 👋"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Foreground="#111827"/>
                        <TextBlock Text="Đăng nhập để tiếp tục quản lý tài chính của bạn"
                                   Margin="0,8,0,24"
                                   FontSize="15"
                                   Foreground="#6B7280"/>

                        <!-- Switch Login/Register -->
                        <Border Background="#F3F4F6"
                                CornerRadius="14"
                                Padding="6"
                                Margin="0,0,0,25">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <Border Background="White"
                                        CornerRadius="12"
                                        Margin="0"
                                        Grid.Column="0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10"
                                                          ShadowDepth="0"
                                                          Opacity="0.08"/>
                                    </Border.Effect>
                                </Border>

                                <Button Content="Đăng nhập"
                                        Grid.Column="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontWeight="SemiBold"
                                        FontSize="14"/>

                                <Button Content="Đăng ký"
                                        Grid.Column="1"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="14"
                                        Click="Register_Click"/>
                            </Grid>
                        </Border>

                        <!-- Email -->
                        <TextBlock Text="Địa chỉ email"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"
                                   Margin="0,0,0,8"/>
                        <Border Height="54"
                                CornerRadius="25"
                                BorderBrush="#D1D5DB"
                                BorderThickness="1"
                                Background="White"
                                Margin="0,0,0,18">
                            <Grid Margin="14,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="✉"
                                           VerticalAlignment="Center"
                                           FontSize="16"
                                           Foreground="#6B7280"/>
                                <TextBox Grid.Column="1"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="15"
                                         VerticalContentAlignment="Center"
                                         Text="minh@email.com"/>
                            </Grid>
                        </Border>

                        <!-- Password -->
                        <TextBlock Text="Mật khẩu"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"
                                   Margin="0,0,0,8"/>
                        <Border Height="54"
                                CornerRadius="25"
                                BorderBrush="#D1D5DB"
                                BorderThickness="1"
                                Background="White"
                                Margin="0,0,0,14">
                            <Grid Margin="14,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔒"
                                           VerticalAlignment="Center"
                                           FontSize="16"
                                           Foreground="#6B7280"/>
                                <PasswordBox Grid.Column="1"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontSize="15"
                                             VerticalContentAlignment="Center"/>
                                <TextBlock Grid.Column="2"
                                           Text="👁"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Foreground="#9CA3AF"/>
                            </Grid>
                        </Border>

                        <!-- Remember / Forgot -->
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Content="Ghi nhớ đăng nhập"
                                      VerticalAlignment="Center"
                                      Foreground="#6B7280"/>

                            <TextBlock Grid.Column="1"
                                       Text="Quên mật khẩu?"
                                       Foreground="#7DC8E8"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Cursor="Hand"
                                       MouseDown="ForgotPassword_Click"/> 
                        </Grid>

                        <!-- Login button -->
                        <Button Content="Đăng nhập"
                                Height="54"
                                Foreground="White"
                                FontSize="16"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="Login_Click">        
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#7DC8E8"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="25">          
                                                    <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#256FB8"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#1F5F9F"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Divider -->
                        <Grid Margin="0,22,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border Height="1" Background="#E5E7EB" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="hoặc tiếp tục với"
                                       Margin="14,0"
                                       Foreground="#9CA3AF"
                                       FontSize="13"/>
                            <Border Grid.Column="2" Height="1" Background="#E5E7EB" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Social -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Width="50" Height="50" CornerRadius="25"
                                    BorderBrush="#E5E7EB" BorderThickness="1" Margin="8,0">
                                <TextBlock Text="G"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <Border Width="50" Height="50" CornerRadius="25"
                                    Background="#111827" Margin="8,0">
                                <TextBlock Text=""
                                           FontSize="18"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <Border Width="50" Height="50" CornerRadius="25"
                                    Background="#7DC8E8" Margin="8,0">
                                <TextBlock Text="f"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Footer text -->
                    <TextBlock Grid.Row="2"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="#9CA3AF"
                               FontSize="13"
                               Margin="20,20,20,0"
                               Text="Theo dõi chi tiêu, lập ngân sách và quản lý mục tiêu tài chính dễ dàng cùng FinanceWise."/>
                </Grid>

                <!-- RIGHT SIDE -->
                <Grid Grid.Column="1">
                    <Border CornerRadius="0,24,24,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#EEF7FF" Offset="0"/>
                                <GradientStop Color="#D6ECFF" Offset="0.5"/>
                                <GradientStop Color="#9ED8FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Grid Grid.Column="1">

                        <Border CornerRadius="0,24,24,0"
            ClipToBounds="True">

                            <Image Source="/Assets/Images/safe.jpg"
               Stretch="UniformToFill"/>
                        </Border>

                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>