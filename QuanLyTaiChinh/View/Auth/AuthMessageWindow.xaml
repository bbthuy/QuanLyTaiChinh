<Window x:Class="QuanLyTaiChinh.View.Auth.AuthMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FinanceWise"
        Width="420"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Border Background="White"
                BorderBrush="#D8ECF6"
                BorderThickness="1"
                CornerRadius="20"
                Padding="28">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24"
                                  ShadowDepth="5"
                                  Opacity="0.18"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="FinanceWise"
                           FontSize="21"
                           FontWeight="Bold"
                           Foreground="#17344A"/>

                <TextBlock x:Name="txtMessage"
                           Margin="0,16,0,24"
                           FontSize="14"
                           LineHeight="22"
                           Foreground="#37566B"
                           TextWrapping="Wrap"/>

                <Button Content="Đã hiểu"
                        Width="115"
                        Height="42"
                        HorizontalAlignment="Right"
                        Background="#6FBFE3"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        IsDefault="True"
                        Click="Close_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>