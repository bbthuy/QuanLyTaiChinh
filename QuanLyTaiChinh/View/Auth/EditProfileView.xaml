<UserControl x:Class="QuanLyTaiChinh.View.Auth.EditProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3FAFD">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Width="520"
                Margin="24"
                Padding="36"
                Background="White"
                CornerRadius="22"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>
                <TextBlock Text="Thông tin tài khoản"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#17344A"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Cập nhật tên và ảnh đại diện của bạn"
                           FontSize="14"
                           Foreground="#819DAD"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,28"/>

                <Border Background="#F3FAFD"
                        CornerRadius="16"
                        Padding="20"
                        Margin="0,0,0,26">
                    <StackPanel HorizontalAlignment="Center">
                        <Grid Width="88" Height="88">
                            <Ellipse x:Name="AvatarPreview"
                                     Fill="#7DC8E8"/>
                            <TextBlock x:Name="PreviewInitial"
                                       Text="?"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Button Content="Chọn ảnh đại diện"
                                Click="ChooseAvatar_Click"
                                Background="White"
                                Foreground="#287DA5"
                                BorderBrush="#BFE1F2"
                                BorderThickness="1"
                                Cursor="Hand"
                                Padding="16,8"
                                Margin="0,14,0,0"/>

                        <TextBlock Text="PNG hoặc JPG, tối đa 2 MB"
                                   Foreground="#94AAB8"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Họ và tên"
                           Foreground="#37566B"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <TextBox x:Name="txtFullName"
                         Height="46"
                         FontSize="14"
                         Padding="12,8"
                         BorderBrush="#CBE7F4"
                         Margin="0,0,0,20"/>

                <TextBlock Text="Email"
                           Foreground="#37566B"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <TextBox x:Name="txtEmail"
                         Height="46"
                         FontSize="14"
                         Padding="12,8"
                         Background="#F5F8FA"
                         BorderBrush="#E1EAF0"
                         IsReadOnly="True"/>

                <TextBlock Text="Email đăng nhập hiện chưa hỗ trợ thay đổi."
                           Foreground="#94AAB8"
                           FontSize="12"
                           Margin="0,7,0,26"/>

                <Button x:Name="btnSave"
                        Content="Lưu thay đổi"
                        Height="48"
                        Background="#7DC8E8"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="Save_Click"
                        Margin="0,0,0,10"/>

                <Button Content="Quay lại"
                        Height="42"
                        Background="Transparent"
                        Foreground="#37566B"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Back_Click"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>